{
  "schema": "burst_motion_sample_v1",
  "id": "street_fighter",
  "title": "🥊 ストリートファイター 風 (5 技セット)",
  "description": "Btn3 (G26) を押しながら振る → 5 種類の格闘技コマンドを姿勢で使い分け。punch/kick (単発) と hadoken/shoryuken/tatsumaki (本格コマンド macro) を Roll/Pitch 2 軸で分散配置し、Closest-only + lock window で誤発火防止。",
  "hardware_required": ["m5stickc", "m5stickc_plus", "m5stickc_2"],
  "engine": {
    "closest_only": true,
    "button_lock_window_ms": 400,
    "cooldown_ms": 300
  },
  "rules": [
    {
      "name": "punch",
      "ui_mode": "oneshot",
      "button_idx": 3,
      "button_state": 0,
      "posture": { "euler": [45, 0, 0], "euler_tol": [15, 25, 180] },
      "accel_abs_threshold": 1.8,
      "key": "p",
      "cooldown_ms": 400
    },
    {
      "name": "kick",
      "ui_mode": "oneshot",
      "button_idx": 3,
      "button_state": 0,
      "posture": { "euler": [-45, 0, 0], "euler_tol": [15, 25, 180] },
      "accel_abs_threshold": 1.8,
      "key": "k",
      "cooldown_ms": 400
    },
    {
      "name": "hadoken",
      "ui_mode": "oneshot",
      "button_idx": 3,
      "button_state": 0,
      "posture": { "euler": [-179, 0, 0], "euler_tol": [15, 25, 180] },
      "accel_abs_threshold": 2.0,
      "keys": ["DOWN", "DOWN+RIGHT", "RIGHT", "RIGHT+p"],
      "interval_ms": 50,
      "cooldown_ms": 600
    },
    {
      "name": "shoryuken",
      "ui_mode": "oneshot",
      "button_idx": 3,
      "button_state": 0,
      "posture": { "euler": [45, -30, 0], "euler_tol": [15, 15, 180] },
      "accel_abs_threshold": 2.5,
      "keys": ["RIGHT", "DOWN", "DOWN+RIGHT", "RIGHT+p"],
      "interval_ms": 50,
      "cooldown_ms": 800
    },
    {
      "name": "tatsumaki",
      "ui_mode": "oneshot",
      "button_idx": 3,
      "button_state": 0,
      "posture": { "euler": [-45, -30, 0], "euler_tol": [15, 15, 180] },
      "accel_abs_threshold": 2.0,
      "keys": ["DOWN", "DOWN+LEFT", "LEFT", "LEFT+k"],
      "interval_ms": 50,
      "cooldown_ms": 700
    }
  ]
}
