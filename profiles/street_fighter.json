{
  "schema": "burst_motion_sample_v1",
  "id": "street_fighter",
  "title": "🥊 ストリートファイター 風",
  "description": "Btn3 (G26) を押しながら傾ける/振る → 攻撃。右傾け→p (パンチ)、左傾け→k (キック)。ボタン押下瞬間の姿勢で lock → 400ms 以内に 1.8g 超の振りで発火。発火後 300ms cooldown で連発防止。姿勢なしルール (旧 hard_attack) は廃止 — 姿勢ありを推奨。",
  "hardware_required": ["m5stickc", "m5stickc_plus", "m5stickc_2"],
  "engine": {
    "closest_only": true,
    "button_lock_window_ms": 400,
    "cooldown_ms": 300
  },
  "rules": [
    {
      "name": "punch",
      "ui_mode": "oneshot",
      "button_idx": 3,
      "button_state": 0,
      "posture": { "euler": [45, 0, 0], "euler_tol": [15, 180, 180] },
      "accel_abs_threshold": 1.8,
      "key": "p",
      "cooldown_ms": 400
    },
    {
      "name": "kick",
      "ui_mode": "oneshot",
      "button_idx": 3,
      "button_state": 0,
      "posture": { "euler": [-45, 0, 0], "euler_tol": [15, 180, 180] },
      "accel_abs_threshold": 1.8,
      "key": "k",
      "cooldown_ms": 400
    }
  ]
}
