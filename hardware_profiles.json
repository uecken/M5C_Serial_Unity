        { "idx": 1, "name": "BtnA", "gpio": 0,  "location": "未確定 (PCB 設計中)", "active_low": true, "default_label": "A" },
        { "idx": 2, "name": "BtnB", "gpio": 1,  "location": "未確定",              "active_low": true, "default_label": "B" }
